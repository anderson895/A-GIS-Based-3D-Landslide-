{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "devCommand": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/",                   "destination": "/viewer/index.html" },
    { "source": "/main.js",            "destination": "/viewer/main.js" },
    { "source": "/style.css",          "destination": "/viewer/style.css" },
    { "source": "/data/:path*",        "destination": "/viewer/data/:path*" },
    { "source": "/lib/:path*",         "destination": "/viewer/lib/:path*" }
  ],
  "headers": [
    {
      "source": "/viewer/data/terrain.bin",
      "headers": [
        { "key": "Content-Type",  "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/viewer/data/(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/viewer/lib/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
